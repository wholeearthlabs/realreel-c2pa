{
  "compilerOptions": {
    "target": "ES2022",
    // Base for both emit passes (tsconfig.esm.json / tsconfig.cjs.json).
    // Not NodeNext: the CJS pass overrides `module` to CommonJS, and under
    // NodeNext the root package's "type": "module" would win instead — so
    // dist/commonjs would come out as ESM. Relative imports already carry
    // explicit `.js` extensions (see the note in src/index.ts).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
