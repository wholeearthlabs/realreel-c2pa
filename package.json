{
  "name": "realreel-c2pa",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source RealReel C2PA trust core, verifier microservice, native capture module, and CA edge functions.",
  "workspaces": [
    "trust-core",
    "verifier",
    "native"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:trust-core": "npm test --workspace trust-core",
    "test:verifier": "npm test --workspace verifier",
    "typecheck:verifier": "cd verifier && npx tsc --noEmit",
    "test:ca": "cd ca && deno test --allow-read --allow-env .",
    "test:pki": "cd pki && deno test --allow-read .",
    "test:ocsp": "cd ocsp && deno test --allow-read .",
    "test:ocsp-leaf": "cd ocsp-leaf && deno test --allow-read --allow-env -c deno.json .",
    "test:native": "npm test --workspace native",
    "test": "npm run build -w trust-core && npm run test:trust-core && npm run typecheck:verifier && npm run test:verifier && npm run test:ca && npm run test:pki && npm run test:ocsp && npm run test:ocsp-leaf && npm run test:native",
    "demo": "cd verifier && tsx ../examples/verify-demo.ts",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1"
  }
}
