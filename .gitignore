# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
*.tsbuildinfo
# Wrangler local state (pki/ Worker: `wrangler dev` / deploy scratch)
.wrangler/
**/.wrangler/
# Signed OCSP responses built by ocsp/build-ocsp-responses.ts (published to
# Workers KV, regenerated on every refresh — never committed).
ocsp/out/
# Packed npm tarballs (e.g. `npm pack` output for local install / device build).
*.tgz
# Compiled TS output for the native Expo module (regenerated by `expo-module
# prepare`; shipped in the npm tarball via package.json "files", not via git).
native/build/
native/plugin/build/

# Test / coverage
coverage/
**/coverage/

# Deno cache
.deno/
**/.deno/

# Native build artifacts
native/android/build/
native/android/.gradle/
native/android/.cxx/
native/ios/build/
**/Pods/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local env
.env
.env.local
.env.*.local

# Service deploy config (non-secret env-specific values; copy from the
# deploy.env.example beside it). One rule for every service, present and future.
**/deploy.env

# Ceremony cert-builder scratch output (build-ca-certs --out; runbook convention)
out/
