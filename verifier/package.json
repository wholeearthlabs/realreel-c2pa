{
  "name": "@realreel/verifier",
  "private": true,
  "version": "0.10.3",
  "description": "RealReel C2PA verifier microservice. Validates the embedded C2PA manifest of each upload against a curated trust list and revocation state; runs synchronously inside the upload path via the verify-and-create-media edge function. Self-contained — imports nothing from the app codebase. Designed for future open-source extraction.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "crjson": "tsx src/harness/cli.ts"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "0.8.3",
    "@contentauth/c2pa-types": "0.7.3",
    "@realreel/c2pa-trust-core": "*",
    "@sentry/node": "^10.70.0",
    "cbor-x": "^1.6.5",
    "exifr": "^7.1.3",
    "fastify": "^5.12.0",
    "google-auth-library": "^11.0.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
