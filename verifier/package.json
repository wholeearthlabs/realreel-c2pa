{
  "name": "@realreel/verifier",
  "private": true,
  "version": "0.13.0",
  "description": "RealReel C2PA verifier microservice. Validates the embedded C2PA manifest of each upload against a curated trust list and revocation state; runs synchronously inside the upload path via the verify-and-create-media edge function. Self-contained — imports nothing from the app codebase. Designed for future open-source extraction.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "crjson": "tsx src/harness/cli.ts"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "0.9.10",
    "@realreel/c2pa-trust-core": "*",
    "@sentry/node": "^10.76.2",
    "cbor-x": "^1.6.8",
    "exifr": "^7.1.3",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
