# Leaf-status OCSP responder deploy config — copy to ocsp-leaf/deploy.env
# (gitignored) and fill in.
#
# Non-secret, environment-specific values only. The responder's real config
# (DATABASE_URL, GCP_KMS_KEY_RESOURCE) is set on the Cloud Run service and is
# preserved across deploys by `gcloud run deploy --image=…`.
#
# Consumed by scripts/deploy-service.sh and scripts/rollback-service.sh
# (`make deploy-ocsp-leaf` / `make rollback-ocsp-leaf` point them here).

# TAG_PREFIX (release-tag prefix; the bare semver after it names the published
# image) comes from `make deploy-ocsp-leaf`, which keeps it in step with the
# publish workflow's tag trigger. Nothing to set here.

# Published, attested source image (built by
# .github/workflows/publish-ocsp-leaf-image.yml on an `ocsp-leaf-v<semver>` tag).
GHCR_IMAGE=ghcr.io/<org>/realreel-ocsp-leaf

# GitHub repo holding the SLSA build-provenance attestation (for `gh attestation verify`).
ATTEST_REPO=<org>/realreel-c2pa

# Artifact Registry image Cloud Run pulls from (Cloud Run cannot pull GHCR
# directly, so the deploy script copies GHCR -> here, preserving the digest).
# Lives in the CA project — the responder signs with the CA hierarchy's
# delegated OCSP key, so it deploys inside that trust boundary, not beside the
# verifier.
GAR_IMAGE=<region>-docker.pkg.dev/<ca-project>/<repo>/ocsp-leaf

# Cloud Run target.
GCP_PROJECT=<ca-project>
GCP_REGION=<region>
CLOUD_RUN_SERVICE=realreel-ocsp-leaf

# Set to false only if `gh` provenance verification is unavailable in your
# environment (e.g. CI without gh). Defaults to true; verification failing
# aborts the deploy.
VERIFY_PROVENANCE=true
